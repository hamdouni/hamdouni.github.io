<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Wordpress on Barim's blog · ابراهيم</title><link>https://barim.us/tags/wordpress/</link><description>Recent content in Wordpress on Barim's blog · ابراهيم</description><generator>Hugo</generator><language>en</language><lastBuildDate>Wed, 07 Jan 2026 10:23:48 +0100</lastBuildDate><atom:link href="https://barim.us/tags/wordpress/index.xml" rel="self" type="application/rss+xml"/><item><title>Increase wordpress max file upload size</title><link>https://barim.us/post/2014-12-05-increase-wordpress-max-file-upload-size/</link><pubDate>Fri, 05 Dec 2014 15:42:56 +0000</pubDate><guid>https://barim.us/post/2014-12-05-increase-wordpress-max-file-upload-size/</guid><description>&lt;p&gt;On Ubuntu/Debian distro, edit the /etc/wordpress/htaccess and add this lines :&lt;/p&gt;&#10;&lt;div class="highlight full-width-content"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-sh" data-lang="sh"&gt;&lt;span class="line"&gt;&lt;span class="ln"&gt;1&lt;/span&gt;&lt;span class="cl"&gt;php_value upload_max_filesize 50M&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="ln"&gt;2&lt;/span&gt;&lt;span class="cl"&gt;php_value post_max_size 50M&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="ln"&gt;3&lt;/span&gt;&lt;span class="cl"&gt;php_value memory_limit 50M&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item></channel></rss>