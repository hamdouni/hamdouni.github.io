<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Kernel on Barim's blog · ابراهيم</title><link>https://barim.us/tags/kernel/</link><description>Recent content in Kernel on Barim's blog · ابراهيم</description><generator>Hugo</generator><language>en</language><lastBuildDate>Wed, 07 Jan 2026 10:23:48 +0100</lastBuildDate><atom:link href="https://barim.us/tags/kernel/index.xml" rel="self" type="application/rss+xml"/><item><title>Make your ubuntu LTS kernel up to date</title><link>https://barim.us/post/2019-10-27-make-your-ubuntu-lts-kernel-up-to-date/</link><pubDate>Sun, 27 Oct 2019 08:10:02 +0000</pubDate><guid>https://barim.us/post/2019-10-27-make-your-ubuntu-lts-kernel-up-to-date/</guid><description>&lt;p&gt;Install &lt;a href="https://wiki.ubuntu.com/Kernel/LTSEnablementStack"&gt;LTS Hardware Enablement Stack&lt;/a&gt;&lt;/p&gt;&#10;&lt;div class="highlight full-width-content"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-sh" data-lang="sh"&gt;&lt;span class="line"&gt;&lt;span class="ln"&gt;1&lt;/span&gt;&lt;span class="cl"&gt;sudo apt-get install --install-recommends linux-generic-hwe-18.04 xserver-xorg-hwe-18.04&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Clean&lt;/p&gt;&#10;&lt;div class="highlight full-width-content"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-sh" data-lang="sh"&gt;&lt;span class="line"&gt;&lt;span class="ln"&gt;1&lt;/span&gt;&lt;span class="cl"&gt;sudo apt purge --autoremove&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Reboot to load new kernel&lt;/p&gt;</description></item></channel></rss>